-- ============================================================================
-- PROYECTO: Análisis de Producción Petrolera
-- ARCHIVO: 03_window_functions_y_tendencias.sql
-- DESCRIPCIÓN: Consultas avanzadas con Window Functions (LAG, SUM OVER, DENSE_RANK)
--              para análisis de series temporales (MoM, YTD y Rankings).
-- ============================================================================

USE petroleos_db; -- Cambia al nombre de tu base de datos
GO

-- ----------------------------------------------------------------------------
-- 1. Variación Porcentual Mes a Mes (MoM) de Producción de Crudo
-- ----------------------------------------------------------------------------
WITH produccion_mensual AS (
    SELECT
        activo,
        anio,
        mes,
        SUM(produccion_crudo) AS crudo_actual,
        LAG(SUM(produccion_crudo), 1) OVER (
            PARTITION BY activo 
            ORDER BY anio, mes
        ) AS crudo_mes_anterior
    FROM datos
    GROUP BY activo, anio, mes
)
SELECT
    activo,
    anio,
    mes,
    ROUND(crudo_actual, 2) AS crudo_actual_bppm,
    ROUND(crudo_mes_anterior, 2) AS crudo_mes_anterior_bppm,
    ROUND(crudo_actual - crudo_mes_anterior, 2) AS diferencia_abs,
    ROUND(
        ((crudo_actual - crudo_mes_anterior) / NULLIF(crudo_mes_anterior, 0)) * 100, 
        2
    ) AS variacion_porcentual_mom
FROM produccion_mensual
ORDER BY activo, anio, mes;


-- ----------------------------------------------------------------------------
-- 2. Acumulado Anual de Producción de Crudo (YTD) por Activo
-- ----------------------------------------------------------------------------
SELECT
    activo,
    anio,
    mes,
    ROUND(SUM(produccion_crudo), 2) AS crudo_mes_bppm,
    ROUND(
        SUM(SUM(produccion_crudo)) OVER (
            PARTITION BY activo, anio 
            ORDER BY mes 
            ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
        ), 
        2
    ) AS acumulado_ytd_bppm
FROM datos
GROUP BY activo, anio, mes
ORDER BY activo, anio, mes;


-- ----------------------------------------------------------------------------
-- 3. Ranking de Activos por Volumen Total de Crudo en el Año
-- ----------------------------------------------------------------------------
WITH produccion_anual_activo AS (
    SELECT
        activo,
        anio,
        SUM(produccion_crudo) AS total_crudo_anio
    FROM datos
    GROUP BY activo, anio
)
SELECT
    anio,
    DENSE_RANK() OVER (
        PARTITION BY anio 
        ORDER BY total_crudo_anio DESC
    ) AS ranking_nacional,
    activo,
    ROUND(total_crudo_anio, 2) AS total_crudo_bppm
FROM produccion_anual_activo
ORDER BY anio ASC, ranking_nacional ASC;
